# ==============================================================================
# Football Intelligence Engine - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. xAI / Grok Configuration (Primary LLM Reasoning Provider)
# ------------------------------------------------------------------------------
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_SECONDS=60
XAI_MAX_TOOL_ROUNDS=8

# ------------------------------------------------------------------------------
# 2. Football Data Providers
# ------------------------------------------------------------------------------
# Options: 'football-data.org', 'api-football', 'demo'
FOOTBALL_DATA_PROVIDER=demo
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# API-Football (RapidAPI or direct)
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_HOST=v3.football.api-sports.io

# ------------------------------------------------------------------------------
# 3. Odds Providers
# ------------------------------------------------------------------------------
# Options: 'the-odds-api', 'demo'
ODDS_PROVIDER=demo
THE_ODDS_API_KEY=your_the_odds_api_key_here
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# ------------------------------------------------------------------------------
# 4. Fetch.ai / Agentverse / ASI:One Configuration
# ------------------------------------------------------------------------------
AGENTVERSE_API_KEY=your_agentverse_api_key_here
AGENT_NAME=FootballIntelligenceAgent
AGENT_SEED=football_intelligence_engine_seed_phrase_here
AGENT_PORT=8000
AGENT_ENDPOINT=http://127.0.0.1:8000/submit

# ------------------------------------------------------------------------------
# 5. Database & Storage
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/football_intel.db
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 6. Statistical & Modeling Thresholds
# ------------------------------------------------------------------------------
MIN_HISTORICAL_MATCHES=10
DEFAULT_DIXON_COLES_RHO=-0.08
PARLAY_5_LEG_MIN_PROB=0.70
PARLAY_10_LEG_MIN_PROB=0.60
MAX_PARLAY_LEGS=10
